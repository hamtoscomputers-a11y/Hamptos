VITE_REACT_APP_API_URL=https://portal.hamtos.com/
VITE_REACT_APP_API_URI=https://portal.hamtos.com
VITE_API_KEY=your_api_key_here

# Dev server only: which backend `npm run dev` proxies /api and /upload to.
# Leave unset for live. Set this while working on an endpoint that has not been
# deployed yet, or the browser talks to live and new routes return
# {"status":false,"error":"Unknown method"}.
# Use 127.0.0.1, not localhost -- PHP's built-in server binds IPv4 only.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8090
